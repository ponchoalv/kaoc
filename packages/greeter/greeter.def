headers      = greeter.h
headerfilter = greeter.h
package      = greeter
compilerOpts = -Ipackages/greeter

# Important: keep `cont char *` as a raw pointer for free_greeting
noStringConversion = free_greeting


# Embed the static library per OS family
staticLibraries.osx   = libgreeter.a
staticLibraries.linux = libgreeter.a
staticLibraries.mingw = greeter.lib

libraryPaths = build

# libraryPaths.osx   = build/macos
# libraryPaths.linux = build/linux
# libraryPaths.mingw = build/windows
